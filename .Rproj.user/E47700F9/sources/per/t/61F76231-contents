H1: Sex at birth (categorical IV) may predict gender equality attitudes (composite variable). 

H2: Intensity of love feelings (continuous) may negatively predict the willingness to marry without love (continuous).

## 1. Load the package and data
```{r load, message=FALSE}
#load the codebook package
library(codebook)

#load data/raw/data_doctored.csv
raw <- read.csv('./data/raw/data_doctored.csv')

#check row and column counts, and inspect the first few rows
dim(raw)
str(raw)

#make data with ID, Country of residence, relationship status, all three gender equality attitudes items, Intensity of love feelings, the willingness to marry without love
data <- raw[,c("ResponseId","Sex_birth","Relationship_status",
               "Gender_Equality_1","Gender_Equality_2","Gender_Equality_3",
               "Love_how_much_1","Love_would_you_marry_1")]
dim(data)
str(data)

```


## 2. Check participant IDs

```{r participant_ids}

#count na
sum(is.na(data$ResponseId))

#count blank
sum(data$ResponseId=="",na.rm=TRUE)
summary(data$ResponseId)

#count duplicates
sum(duplicated(data$ResponseId))

#inspect records with missing or blank IDs
missID <- which(is.na(data$ResponseId))
data[missID,]

#remove the known empty record with no ID, then check the row count
data <- data[!is.na(data$ResponseId),]

```


## 3. Recode sex at birth

```{r sex_at_birth}
# codebook: 0 = Male, 1 = Female, 2 = Intersex
table(data$Sex_birth, useNA="ifany")
#turn Sex_birth into a factor with labels Male, Female, and Intersex
data$Sex_birth <- factor(data$Sex_birth,
                         levels=c(0,1,2),
                         labels=c("Male","Female","Intersex"))

```


## 4. Validate gender equality attitudes

```{r equality_vars}
#group all three Gender_Equality_ variables
equalityvars <- c("Gender_Equality_1","Gender_Equality_2","Gender_Equality_3")

#see summary of variables
summary(data[,equalityvars])

#count NAs
colSums(is.na(data[,equalityvars]))

#define the items to check; all three use response codes 1-7
#Gender_Equality_1-3: 1=Definitely disagree, 7=Definitely agree
likert7 <- c("Gender_Equality_1","Gender_Equality_2","Gender_Equality_3")

for(i in likert7){
  print(i)
  print(table(data[,i],useNA="ifany"))
}

#replace any codes outside 1-7 with NA
for(i in likert7){
  data[,i] <- as.numeric(ifelse(data[,i] %in% 1:7, data[,i], NA))
}

#calculate gender_equality as the mean of all three items
#for NAs, conduct available item mean
data$gender_equa <- rowMeans(data[,likert7], na.rm=TRUE)

#make h1Data with ID, Sex_birth, and gender_equa
h1Data <- data[!is.na(data$Sex_birth) & !is.na(data$gender_equa), c("ResponseId","Sex_birth","gender_equa")]

```


## 5.  H2: Intensity of love feelings ("Love_how_much_1") may negatively predict the willingness to marry without love ("Love_would_you_marry_1").
```{r screen relationship status}
#make relData for respondents currently in a relationship
#include Dating (1), In a committed relationship (2), and Married (3)
table(data$Relationship_status, useNA="ifany")
relData <- data[data$Relationship_status %in% c(1,2,3),]

#define the items to check; response codes 0-100
varcheck <- c("Love_how_much_1","Love_would_you_marry_1")

#replace any codes outside 0-100 with NA
for(i in varcheck){
  relData[,i] <- ifelse(relData[,i] >= 0 & relData[,i] <= 100, relData[,i], NA)
}

h2Data <- relData[!is.na(relData$Love_how_much_1) & !is.na(relData$Love_would_you_marry_1),c("ResponseId","Relationship_status","Love_how_much_1","Love_would_you_marry_1")]

```

